# Cardano Preprod configuration for the StellarVault backend.
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials.

# Free project ID from https://blockfrost.io (choose the "Preprod" network
# when creating the project).
BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Cardano network this backend talks to. StellarVault targets Preprod only.
NETWORK=Preprod

# Seed phrase for the *service* wallet used to submit bootstrap/demo
# transactions in development. Generate a fresh wallet dedicated to
# Preprod testing — fund it only via the Preprod faucet, and never reuse
# a mainnet or personal wallet's seed here.
WALLET_SEED="replace with a 24-word preprod-only seed phrase"

# HTTP port the Express API listens on.
PORT=4000

# Where the JSON file store keeps escrow records.
DATA_DIR=./data
