# Copy to scripts/.env before running the deploy script.

# Free project ID from https://blockfrost.io — create it under the
# "Preprod" network.
BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Seed phrase for a Preprod-only wallet. Fund it from the faucet at
# https://docs.cardano.org/cardano-testnets/tools/faucet before deploying.
# Never reuse a mainnet seed here.
WALLET_SEED="replace with a 24-word preprod-only seed phrase"
